# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# This is a public key and safe to expose in the browser
PUBLIC_SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# Sentry Source Map Upload Configuration (for CI/CD)
# Get auth token from: https://sentry.io/settings/account/api/auth-tokens/
# Keep this secret! Do not commit to version control
SENTRY_AUTH_TOKEN=your_auth_token_here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
