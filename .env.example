# Honeybadger.io Error Tracking Configuration
# Get your API key from https://app.honeybadger.io

# Public API key (exposed to client-side code)
PUBLIC_HONEYBADGER_API_KEY=your_honeybadger_api_key_here

# Environment name (e.g., production, staging, development)
PUBLIC_HONEYBADGER_ENVIRONMENT=production

# Optional: Git revision/commit hash for error tracking
PUBLIC_HONEYBADGER_REVISION=

# Private server-side API key (not exposed to clients)
# Use the same key as public for most cases, or separate keys if needed
HONEYBADGER_API_KEY=your_honeybadger_api_key_here
HONEYBADGER_ENVIRONMENT=production
HONEYBADGER_REVISION=
